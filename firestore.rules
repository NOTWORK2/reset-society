rules_version = '2';

// Reset Society — Firestore security rules.
// Deploy from the site folder:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Guests per time slot for each service. Once the admin saves its Settings, this comes from
    // settings/site.capacity (hidden services are 0 = not bookable). Before that, these defaults apply.
    function capacity(svc) {
      let site = /databases/$(database)/documents/settings/site;
      return exists(site)
        ? get(site).data.get('capacity', {}).get(svc, 0)
        : {
            'cold-plunge': 1,
            'sauna': 1,
            'compression-boots': 1,
            'full-recovery': 1
          }.get(svc, 0);
    }

    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function validDate(d) { return d is string && d.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }
    function validTime(t) { return t is string && t.matches('^[0-2][0-9]:[0-5][0-9]$'); }
    function notPast(d) {
      let p = d.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(1, 'd') > request.time;
    }
    function dayOpen(d) {
      let s = /databases/$(database)/documents/settings/public;
      return !exists(s) || !(d in get(s).data.get('closedDates', []));
    }
    function bookingPath(id) { return /databases/$(database)/documents/bookings/$(id); }
    function lockPath(id) { return /databases/$(database)/documents/slotLocks/$(id); }

    // When a session starts (studio time is UTC+4), from its 'YYYY-MM-DD' and 'HH:MM' strings.
    function startsAt(d, t) {
      let p = d.split('-');
      let q = t.split(':');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(int(q[0]), 'h') + duration.value(int(q[1]), 'm') - duration.value(4, 'h');
    }
    // A booking belongs to the signed-in customer: made from their account or on their registered phone.
    function ownsBooking(d) {
      return signedIn() && (d.uid == request.auth.uid || d.get('phoneDigits', '') == myPhone());
    }

    function myPhone() {
      let c = /databases/$(database)/documents/customers/$(request.auth.uid);
      return exists(c) ? get(c).data.get('phoneDigits', '-') : '-';
    }

    // Customer accounts: a person's own profile, plus a one-per-number claim on the phone.
    match /customers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'phoneDigits', 'email', 'hasEmail', 'createdAt'])
        && str(request.resource.data.name, 100)
        && request.resource.data.phoneDigits is string && request.resource.data.phoneDigits.matches('^[0-9]{8,15}$')
        && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phoneDigits)).data.uid == uid;
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'hasEmail']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['packName', 'packTotal', 'balance', 'packAssignedAt', 'balanceUpdatedAt', 'note']));
      allow delete: if isAdmin();
    }
    match /phones/{digits} {
      // Signed-in users may look up one number (to see if it's taken); only admins may list them.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // add admins from the Firebase console
    }

    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Prices, services, hours, contact details and policy, edited from the admin Settings tab.
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.services is list
        && request.resource.data.capacity is map;
    }

    // Service photos uploaded from the admin (small JPEGs stored as data URLs).
    match /media/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.data.size() < 900000;
      allow delete: if isAdmin();
    }

    // Background music uploaded from the admin, stored as base64 parts under 1 MiB each.
    match /audio/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'chunks', 'createdAt'])
        && request.resource.data.type.matches('^audio/.*');
      allow delete: if isAdmin();
      match /parts/{n} {
        allow read: if true;
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['n', 'data'])
          && request.resource.data.n is int
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow delete: if isAdmin();
      }
    }

    // One document per taken place in a time slot. Public (no personal data) so the booking
    // page can show which times are free. A guest can only create one together with its booking.
    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.keys().hasOnly(['date', 'time', 'service', 'n', 'bookingId'])
        && validDate(request.resource.data.date)
        && validTime(request.resource.data.time)
        && request.resource.data.n is int
        && request.resource.data.n >= 1
        && request.resource.data.n <= capacity(request.resource.data['service'])
        && lockId == request.resource.data.date + '_' + request.resource.data.time + '_'
                     + request.resource.data['service'] + '_' + string(request.resource.data.n)
        && str(request.resource.data.bookingId, 20)
        && getAfter(bookingPath(request.resource.data.bookingId)).data.lockId == lockId
        && (
          // a new booking saved in the same batch …
          !exists(bookingPath(request.resource.data.bookingId))
          // … or a customer moving their own confirmed booking to this place
          || (ownsBooking(get(bookingPath(request.resource.data.bookingId)).data)
              && getAfter(bookingPath(request.resource.data.bookingId)).data.status == 'confirmed'
              && getAfter(bookingPath(request.resource.data.bookingId)).data.date == request.resource.data.date
              && getAfter(bookingPath(request.resource.data.bookingId)).data.time == request.resource.data.time
              && get(bookingPath(request.resource.data.bookingId)).data['service'] == request.resource.data['service'])
        )
      );
      allow update: if false;
      // The owner frees the place when cancelling or moving their own booking (same batch).
      allow delete: if isAdmin() || (
        signedIn()
        && ownsBooking(get(bookingPath(resource.data.bookingId)).data)
        && (getAfter(bookingPath(resource.data.bookingId)).data.status == 'cancelled'
            || getAfter(bookingPath(resource.data.bookingId)).data.lockId != lockId)
      );
    }

    function validBooking(id, d) {
      let lock = getAfter(lockPath(d.lockId)).data;
      return d.keys().hasOnly(['ref', 'service', 'serviceName', 'price', 'currency', 'date', 'time',
                               'name', 'phone', 'phoneDigits', 'email', 'pay', 'status', 'lockId', 'uid', 'createdAt'])
        && d.keys().hasAll(['ref', 'service', 'serviceName', 'price', 'currency', 'date', 'time',
                            'name', 'phone', 'pay', 'status', 'lockId', 'uid', 'createdAt'])
        && id.matches('^RS-[0-9]{5}$') && d.ref == id
        && d.uid == request.auth.uid
        && d.status == 'confirmed'
        && capacity(d['service']) > 0
        && str(d.serviceName, 60)
        && d.price is number && d.price >= 0
        && str(d.currency, 5)
        && validDate(d.date) && validTime(d.time) && notPast(d.date) && dayOpen(d.date)
        && str(d.name, 100)
        && str(d.phone, 30)
        && (!('phoneDigits' in d) || (d.phoneDigits is string && d.phoneDigits.size() <= 15))
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        // Online payment isn't live yet; allow 'online' only once payments are verified server-side.
        && d.pay == 'location'
        && d.createdAt == request.time
        && str(d.lockId, 80)
        && !exists(lockPath(d.lockId))
        && lock.bookingId == id
        && lock.date == d.date && lock.time == d.time && lock['service'] == d['service'];
    }

    // Membership / session-pack join requests from the Memberships page.
    function validPlanRequest(d) {
      return d.keys().hasOnly(['ref', 'type', 'planId', 'label', 'sessions', 'price', 'currency',
                               'name', 'phone', 'email', 'lang', 'status', 'uid', 'createdAt'])
        && d.keys().hasAll(['ref', 'type', 'planId', 'label', 'sessions', 'price', 'currency',
                            'name', 'phone', 'status', 'uid', 'createdAt'])
        && d.type in ['membership', 'pack']
        && str(d.ref, 20) && str(d.planId, 40) && str(d.label, 80)
        && d.sessions is int && d.sessions > 0 && d.sessions <= 500
        && d.price is number && d.price >= 0
        && str(d.currency, 5)
        && str(d.name, 100) && str(d.phone, 30)
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('lang' in d) || d.lang in ['en', 'ar'])
        && d.status == 'new'
        && d.uid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /planRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && validPlanRequest(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /bookings/{id} {
      // Customers see their own bookings: made from their account, or matching their registered phone.
      allow read: if isAdmin() || (signedIn() && (resource.data.uid == request.auth.uid || resource.data.phoneDigits == myPhone()));
      allow create: if isAdmin() || (signedIn() && validBooking(id, request.resource.data));
      allow delete: if isAdmin();
      // Customers may cancel or move their own confirmed booking up to 24 hours before it starts.
      allow update: if isAdmin() || (
        ownsBooking(resource.data)
        && resource.data.status == 'confirmed'
        && startsAt(resource.data.date, resource.data.time) > request.time + duration.value(24, 'h')
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledBy'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'customer')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time', 'lockId', 'updatedAt', 'rescheduledFrom', 'movedBy'])
            && request.resource.data.movedBy == 'customer'
            && validDate(request.resource.data.date) && validTime(request.resource.data.time)
            && dayOpen(request.resource.data.date)
            && startsAt(request.resource.data.date, request.resource.data.time) > request.time
            && request.resource.data.lockId != resource.data.lockId
            && getAfter(lockPath(request.resource.data.lockId)).data.bookingId == id
            && !existsAfter(lockPath(resource.data.lockId)))
        )
      );
    }
  }
}
